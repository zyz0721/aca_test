├── include/
│   ├── core/
│   │   ├── DynamicsBase.hpp       # 动力学基类
│   │   ├── CostBase.hpp           # 代价函数基类
│   │   ├── ConstraintBase.hpp     # 约束基类
│   │   └── OcpProblem.hpp         # OCP 问题统筹类
│   └── solver/
│       ├── AcadosGenericWrapper.hpp # ★ 通用 Acados 封装器
│       └── NmpcSolver.hpp         # 给外部调用的统一接口
└── src/
    └── ...

galbot_models/ (具体机器人模型库)
├── chassis/
│   ├── SwerveChassisDynamics.hpp  # 你现在的舵轮底盘模型
│   └── generated_c_code/          # Acados 生成的底盘 C 代码
├── arm/
│   ├── FrankaArmDynamics.hpp      # 7轴机械臂模型
│   └── generated_c_code/          # Acados 生成的机械臂 C 代码
└── ...

# 基类定义 galbot_nmpc_core
// DynamicsBase.hpp
#pragma once
#include <string>

namespace galbot {
namespace nmpc {

class DynamicsBase {
public:
    virtual ~DynamicsBase() = default;

    // 强制派生类提供名字（用于匹配 Acados 生成的 C 函数前缀）
    virtual std::string getModelName() const = 0;

    // 状态量和控制量的维度
    virtual int getNx() const = 0; // Number of states
    virtual int getNu() const = 0; // Number of controls

    // 【离线使用】利用 CasADi 符号库定义连续动力学 dx/dt = f(x, u)
    // 机械臂和底盘在这里重写各自的物理公式
    virtual casadi::SX computeRHS(const casadi::SX& x, const casadi::SX& u) = 0;
};

} // namespace nmpc
} // namespace galbot

# 底盘模型：
// SwerveChassisDynamics.hpp
#include "DynamicsBase.hpp"

class SwerveChassisDynamics : public galbot::nmpc::DynamicsBase {
public:
    std::string getModelName() const override { return "chassis_model"; }
    int getNx() const override { return 6; } // x, y, yaw, vx, vy, dyaw
    int getNu() const override { return 3; } // ax, ay, ddyaw

    casadi::SX computeRHS(const casadi::SX& x, const casadi::SX& u) override {
        // 底盘专属的微分方程
        return casadi::SX::vertcat({
            x(3) * cos(x(2)) - x(4) * sin(x(2)),
            x(3) * sin(x(2)) + x(4) * cos(x(2)),
            x(5),
            u(0), u(1), u(2)
        });
    }
};

