        <joint range="-3.14 3.14" limited="true"/>
        <position kp="200" kv="10" ctrlrange="-3.14 3.14"/>
      </default>

      <default class="wheel_velocity">  <!-- 适用于底盘的速度控制，关节限幅，控制限赋，控制增益-->
