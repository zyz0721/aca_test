        <joint limited="false"/>
      </default>

      <default class="steer_motor">  <!--方向舵机的力矩控制器，需填入实际力矩Nm-->
        <motor ctrlrange="-100 100"/>
      </default>

      <default class="galbot_S1_motor">  <!--head/torso/arm的力矩控制器，需填入实际力矩Nm-->
        <motor gear="1" ctrllimited="true" forcelimited="true" ctrlrange="-6000 6000" forcerange="-6000 6000"/>
      </default>

      <default class="galbot_S1_position">  <!-- 位置控制，关节限幅，控制限赋，控制增益-->
        <position kp="4000" kv="300" ctrlrange="-4 4" forcerange="-3000 3000"/>
      </default>

      <default class="visual">
        <geom material="default_material" contype="0" conaffinity="0" group="1" density="0"/>
      </default>
      <default class="collision">
        <geom material="collision_material" contype="1" conaffinity="1" group="3" density="0"/>
      </default>
      <default class="wheel_geom">
        <geom contype="1" conaffinity="1" group="3" density="1100" friction="1 0.01 0.01" solref="0.005 1" solimp="0.99 0.999 1e-05"/>
